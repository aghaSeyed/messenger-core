{
    "name": "paya/transfer-system",
    "description": "State-based money transfer system with DDD principles",
    "type": "project",
    "require": {
        "php": ">=8.1",
        "nikic/fast-route": "^1.3",
        "ramsey/uuid": "^4.7",
      "ext-openssl": "*"
    },
    "autoload": {
        "psr-4": {
            "Paya\\": "src/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true,
        "secure-http": false
    },
    "repositories": {
    }
}
